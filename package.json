{
  "name": "interactive-guide",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "bin": {
    "guide-workbench": "./dist/server/workbench-cli.js"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:admin": "cd src/admin && npm run dev",
    "build:server": "tsc -p tsconfig.server.json",
    "build:admin": "cd src/admin && vite build",
    "build:workbench": "npm run build:server && npm run build:admin",
    "start:workbench": "node dist/server/workbench-cli.js start --workspace ./data --port auto --json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "coverage": "c8 --reporter=text --reporter=lcov --exclude='tests/**' --exclude='src/admin/node_modules/**' --exclude='**/*.d.ts' node --import tsx --test \"tests/**/*.test.ts\"",
    "coverage:check": "c8 --reporter=text --reporter=lcov --check-coverage --lines=30 --functions=30 --branches=25 --statements=30 --exclude='tests/**' --exclude='src/admin/node_modules/**' --exclude='**/*.d.ts' node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/adm-zip": "^0.5.8",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.17",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "acorn": "^8.17.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
