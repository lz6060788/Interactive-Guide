{
  "name": "interactive-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:admin": "cd src/admin && npm run dev",
    "build:server": "tsc -p tsconfig.server.json",
    "build:admin": "cd src/admin && vite build",
    "build:pipeline": "tsx src/server/build-pipeline.ts",
    "typecheck": "tsc --noEmit",
    "validate:package": "tsx src/shared/validate-package.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.17",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
