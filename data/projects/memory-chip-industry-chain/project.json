    "items": {
      "item-semiconductor-wafers": {
        "id": "item-semiconductor-wafers",
        "categoryId": "category-upstream-wafer-materials",
        "title": {
          "zh-CN": "半导体硅片",
          "en-US": "Semiconductor Wafers"
        },
        "description": {
          "zh-CN": "存储晶圆制造的基础衬底，尺寸、洁净度和晶体缺陷水平会影响良率和成本。",
          "en-US": "The base substrate for memory wafer fabrication; wafer size, cleanliness, and crystal defect levels directly affect yield and cost."
        },
        "order": 0
      },
      "item-photoresist-chemicals": {
        "id": "item-photoresist-chemicals",
        "categoryId": "category-upstream-wafer-materials",
        "title": {
          "zh-CN": "光刻胶与配套试剂",
          "en-US": "Photoresists and Ancillary Chemicals"
        },
        "description": {
          "zh-CN": "光刻图形转移所需的关键化学材料，分辨率、稳定性和配套显影清洗能力决定图形精度。",
          "en-US": "Critical chemicals used in lithographic pattern transfer; resolution, stability, and compatible developing and cleaning processes determine pattern fidelity."
        },
        "order": 1
      },
      "item-electronic-specialty-gases": {
        "id": "item-electronic-specialty-gases",
        "categoryId": "category-upstream-wafer-materials",
        "title": {
          "zh-CN": "电子特气",
          "en-US": "Electronic Specialty Gases"
        },
        "description": {
          "zh-CN": "刻蚀、沉积和清洗中使用的高纯气体，纯度和供气稳定性直接关系到存储器多层结构的一致性。",
          "en-US": "High-purity gases used in etching, deposition, and cleaning; gas purity and supply stability directly affect the consistency of multilayer memory structures."
        },
        "order": 2
      },
      "item-targets-precursors": {
        "id": "item-targets-precursors",
        "categoryId": "category-upstream-wafer-materials",
        "title": {
          "zh-CN": "靶材与前驱体",
          "en-US": "Sputtering Targets and Precursors"
        },
        "description": {
          "zh-CN": "形成金属互连、阻挡层和介质薄膜的重要材料，影响存储单元连接可靠性和薄膜质量。",
          "en-US": "Key materials for forming metal interconnects, barrier layers, and dielectric films, affecting memory-cell connection reliability and film quality."
        },
        "order": 3
      },
      "item-cmp-materials": {
        "id": "item-cmp-materials",
        "categoryId": "category-upstream-wafer-materials",
        "title": {
          "zh-CN": "CMP抛光材料",
          "en-US": "CMP Polishing Materials"
        },
        "description": {
          "zh-CN": "化学机械平坦化所需耗材，决定多层堆叠结构表面平整度，是先进存储良率的重要支撑。",
          "en-US": "Consumables for chemical mechanical planarization that determine surface flatness in multilayer stacks and support yields in advanced memory production."
        },
        "order": 4
      },
      "item-lithography-equipment": {
        "id": "item-lithography-equipment",
        "categoryId": "category-upstream-front-end-equipment",
        "title": {
          "zh-CN": "光刻设备",
          "en-US": "Lithography Equipment"
        },
        "description": {
          "zh-CN": "把电路图形投射到晶圆上的核心设备，决定存储芯片线宽、套刻精度和先进制程推进节奏。",
          "en-US": "Core equipment that projects circuit patterns onto wafers, determining memory-chip feature size, overlay accuracy, and the pace of process-node advancement."
        },
        "order": 0
      },
      "item-etch-equipment": {
        "id": "item-etch-equipment",
        "categoryId": "category-upstream-front-end-equipment",
        "title": {
          "zh-CN": "刻蚀设备",
          "en-US": "Etching Equipment"
        },
        "description": {
          "zh-CN": "在晶圆上精确去除材料形成沟槽、孔洞和存储单元结构，3D NAND 层数提升会显著增加刻蚀难度。",
          "en-US": "Precisely removes wafer material to form trenches, holes, and memory-cell structures; higher 3D NAND layer counts significantly increase etching complexity."
        },
        "order": 1
      },
      "item-thin-film-deposition-equipment": {
        "id": "item-thin-film-deposition-equipment",
        "categoryId": "category-upstream-front-end-equipment",
        "title": {
          "zh-CN": "薄膜沉积设备",
          "en-US": "Thin-Film Deposition Equipment"
        },
        "description": {
          "zh-CN": "在晶圆表面沉积介质、金属或阻挡层薄膜，薄膜均匀性决定多层存储结构的电学表现。",
          "en-US": "Deposits dielectric, metal, or barrier films on wafer surfaces; film uniformity determines the electrical performance of multilayer memory structures."
        },
        "order": 2
      },
      "item-cleaning-cmp-equipment": {
        "id": "item-cleaning-cmp-equipment",
        "categoryId": "category-upstream-front-end-equipment",
        "title": {
          "zh-CN": "清洗与CMP设备",
          "en-US": "Cleaning and CMP Equipment"
        },
        "description": {
          "zh-CN": "在关键工序间去除颗粒、残留物并平坦化晶圆表面，是存储芯片提高良率的基础设备。",
          "en-US": "Removes particles and residues between critical process steps and planarizes wafer surfaces, providing essential support for higher memory-chip yields."
        },
        "order": 3
      },
      "item-metrology-inspection-equipment": {
        "id": "item-metrology-inspection-equipment",
        "categoryId": "category-upstream-front-end-equipment",
        "title": {
          "zh-CN": "量检测设备",
          "en-US": "Metrology and Inspection Equipment"
        },
        "description": {
          "zh-CN": "在制造过程中检查缺陷、膜厚和关键尺寸，帮助晶圆厂及时纠偏并稳定良率。",
          "en-US": "Inspects defects, film thickness, and critical dimensions during fabrication, enabling fabs to correct process drift and stabilize yields."
        },
        "order": 4
      },
      "item-packaging-equipment": {
        "id": "item-packaging-equipment",
        "categoryId": "category-upstream-packaging-test",
        "title": {
          "zh-CN": "封装设备",
          "en-US": "Packaging Equipment"
        },
        "description": {
          "zh-CN": "后道封装中固晶、键合、塑封、切割减薄和先进封装互连所需设备；HBM、2.5D/3D封装和Chiplet提升封装复杂度，带动高精度贴装、混合键合、切割减薄等设备需求。",
          "en-US": "Equipment for die attach, bonding, molding, dicing, thinning, and advanced interconnects. HBM, 2.5D/3D packaging, and chiplets increase complexity and demand for high-precision placement, hybrid bonding, dicing, and thinning tools."
        },
        "order": 0
      },
      "item-test-equipment": {
        "id": "item-test-equipment",
        "categoryId": "category-upstream-packaging-test",
        "title": {
          "zh-CN": "测试设备",
          "en-US": "Test Equipment"
        },
        "description": {
          "zh-CN": "对晶圆、裸片和封装后的存储器进行速度、容量和可靠性筛选，是出货质量控制的关键环节。",
          "en-US": "Screens wafers, bare dies, and packaged memory for speed, capacity, and reliability, serving as a critical gate for shipment quality."
        },
        "order": 1
      },
      "item-packaging-substrate-lead-materials": {
        "id": "item-packaging-substrate-lead-materials",
        "categoryId": "category-upstream-packaging-test",
        "title": {
          "zh-CN": "封装基板与引线材料",
          "en-US": "Packaging Substrates and Interconnect Materials"
        },
        "description": {
          "zh-CN": "承载芯片电连接和机械支撑的基础材料，先进存储封装对基板层数、线宽和热稳定性要求更高。",
          "en-US": "Foundational materials for chip electrical connections and mechanical support; advanced memory packaging demands more substrate layers, finer lines, and greater thermal stability."
        },
        "order": 2
      },
      "item-memory-wafer-manufacturing": {
        "id": "item-memory-wafer-manufacturing",
        "categoryId": "category-midstream-wafer-manufacturing",
        "title": {
          "zh-CN": "存储晶圆制造",
          "en-US": "Memory Wafer Manufacturing"
        },
        "description": {
          "zh-CN": "把材料、设备和工艺整合成 DRAM、NAND 等晶圆，是存储芯片产能、良率和成本的核心环节。",
          "en-US": "Integrates materials, equipment, and processes to produce DRAM, NAND, and other memory wafers, forming the core of industry capacity, yield, and cost."
        },
        "order": 0
      },
      "item-dram": {
        "id": "item-dram",
        "categoryId": "category-midstream-memory-products",
        "title": {
          "zh-CN": "DRAM",
          "en-US": "DRAM"
        },
        "description": {
          "zh-CN": "动态随机存取存储器承担运行数据的临时存放，价格周期、制程和产能利用率对行业景气影响很大。",
          "en-US": "Dynamic random-access memory temporarily stores active data; pricing cycles, process technology, and capacity utilization strongly influence industry conditions."
        },
        "order": 0
      },
      "item-3d-nand-flash": {
        "id": "item-3d-nand-flash",
        "categoryId": "category-midstream-memory-products",
        "title": {
          "zh-CN": "3D NAND Flash",
          "en-US": "3D NAND Flash"
        },
        "description": {
          "zh-CN": "通过垂直堆叠提升容量密度的非易失存储，层数、良率和成本决定 SSD 与终端存储竞争力。",
          "en-US": "Non-volatile memory that increases density through vertical stacking; layer count, yield, and cost determine the competitiveness of SSDs and device storage."
        },
        "order": 1
      },
      "item-nor-flash": {
        "id": "item-nor-flash",
        "categoryId": "category-midstream-memory-products",
        "title": {
          "zh-CN": "NOR Flash",
          "en-US": "NOR Flash"
        },
        "description": {
          "zh-CN": "适合代码存储和快速随机读取的闪存，常用于启动程序、物联网和汽车电子等场景。",
          "en-US": "Flash memory suited to code storage and fast random reads, commonly used for boot code, IoT devices, and automotive electronics."
        },
        "order": 2
      },
      "item-eeprom": {
        "id": "item-eeprom",
        "categoryId": "category-midstream-memory-products",
        "title": {
          "zh-CN": "EEPROM",
          "en-US": "EEPROM"
        },
        "description": {
          "zh-CN": "可电擦写的小容量非易失存储器，适合保存配置、身份识别和校准参数等小数据。",
          "en-US": "Electrically erasable, low-capacity non-volatile memory suited to storing configuration, identification, and calibration data."
        },
        "order": 3
      },
      "item-hbm-stacked-packaging": {
        "id": "item-hbm-stacked-packaging",
        "categoryId": "category-midstream-advanced-packaging",
        "title": {
          "zh-CN": "HBM堆叠封装",
          "en-US": "HBM Stacked Packaging"
        },
        "description": {
          "zh-CN": "把多层 DRAM 通过垂直互连堆叠在一起，为 AI 加速器提供高带宽、低延迟的近端内存。",
          "en-US": "Stacks multiple DRAM dies through vertical interconnects to provide AI accelerators with high-bandwidth, low-latency local memory."
        },
        "order": 0
      },
      "item-tsv-microbump-interconnect": {
        "id": "item-tsv-microbump-interconnect",
        "categoryId": "category-midstream-advanced-packaging",
        "title": {
          "zh-CN": "TSV与微凸块互连",
          "en-US": "TSV and Micro-Bump Interconnects"
        },
        "description": {
          "zh-CN": "穿硅通孔和微凸块把多层裸片垂直连接，是 HBM 带宽、功耗和封装良率的关键结构。",
          "en-US": "Through-silicon vias and micro-bumps vertically connect multiple dies and are critical to HBM bandwidth, power consumption, and packaging yield."
        },
        "order": 1
      },
      "item-silicon-interposer": {
        "id": "item-silicon-interposer",
        "categoryId": "category-midstream-advanced-packaging",
        "title": {
          "zh-CN": "硅中介层",
          "en-US": "Silicon Interposers"
        },
        "description": {
          "zh-CN": "在 HBM 与 GPU 等芯片之间承担高密度布线和信号转接，是 2.5D 封装的重要连接平台。",
          "en-US": "Provides high-density routing and signal redistribution between HBM and processors such as GPUs, serving as a key interconnect platform for 2.5D packaging."
        },
        "order": 2
      },
      "item-memory-module": {
        "id": "item-memory-module",
        "categoryId": "category-midstream-memory-modules",
        "title": {
          "zh-CN": "内存模组",
          "en-US": "Memory Modules"
        },
        "description": {
          "zh-CN": "把 DRAM 颗粒、PCB 和电源管理等组合成可插拔内存条，是 PC 与服务器扩容的主要形态。",
          "en-US": "Combines DRAM chips, a PCB, and power-management components into pluggable modules, the primary form of memory expansion for PCs and servers."
        },
        "order": 0
      },
      "item-ssd": {
        "id": "item-ssd",
        "categoryId": "category-midstream-memory-modules",
        "title": {
          "zh-CN": "固态硬盘SSD",
          "en-US": "Solid-State Drives (SSDs)"
        },
        "description": {
          "zh-CN": "由 NAND 颗粒、主控和固件组成的高速存储产品，容量、寿命和单位成本决定终端体验。",
          "en-US": "High-speed storage products built from NAND flash, controllers, and firmware; capacity, endurance, and cost per unit determine the end-user experience."
        },
        "order": 1
      },
      "item-ai-server": {
        "id": "item-ai-server",
        "categoryId": "category-downstream-compute-servers",
        "title": {
          "zh-CN": "AI服务器",
          "en-US": "AI Servers"
        },
        "description": {
          "zh-CN": "大模型训练和推理的硬件载体，对 HBM、DDR 和 SSD 的带宽、容量和可靠性提出更高要求。",
          "en-US": "Hardware platforms for training and running large AI models, imposing higher bandwidth, capacity, and reliability requirements on HBM, DDR, and SSDs."
        },
        "order": 0
      },
      "item-data-center-storage": {
        "id": "item-data-center-storage",
        "categoryId": "category-downstream-compute-servers",
        "title": {
          "zh-CN": "数据中心存储",
          "en-US": "Data Center Storage"
        },
        "description": {
          "zh-CN": "面向云计算和企业数据的集中存储系统，推动企业级 SSD、服务器内存和高可靠存储方案升级。",
          "en-US": "Centralized storage systems for cloud computing and enterprise data that drive upgrades in enterprise SSDs, server memory, and high-reliability storage solutions."
        },
        "order": 1
      },
      "item-smartphone-ai-pc": {
        "id": "item-smartphone-ai-pc",
        "categoryId": "category-downstream-terminal-electronics",
        "title": {
          "zh-CN": "智能手机与AI PC",
          "en-US": "Smartphones and AI PCs"
        },
        "description": {
          "zh-CN": "消费终端同时使用运行内存和闪存，AI 功能、影像和本地模型会提升容量和速度需求。",
          "en-US": "Consumer devices use both working memory and flash storage; AI features, imaging, and on-device models increase capacity and performance requirements."
        },
        "order": 0
      },
      "item-automotive-industrial-control": {
        "id": "item-automotive-industrial-control",
        "categoryId": "category-downstream-terminal-electronics",
        "title": {
          "zh-CN": "汽车电子与工业控制",
          "en-US": "Automotive Electronics and Industrial Control"
        },
        "description": {
          "zh-CN": "车规和工业场景要求存储芯片长期稳定、耐温和可追溯，带动 NOR、EEPROM 和嵌入式存储需求。",
          "en-US": "Automotive and industrial applications require long-term stability, temperature tolerance, and traceability, driving demand for NOR flash, EEPROM, and embedded storage."
        },
        "order": 1
      }
    }
  },
