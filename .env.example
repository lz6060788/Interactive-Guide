# Server
PORT=8788
CORS_ORIGIN=http://localhost:5173

# Vision / LLM Provider (OpenAI-compatible, used for page planning & hotspot recommendation)
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=kimi-k2.6
VISION_TIMEOUT_MS=60000
VISION_TEMPERATURE=0.6

# Image Generation Provider (DashScope)
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
IMAGE_MODEL=qwen-image-2.0-pro
IMAGE_TIMEOUT_MS=120000

# Video Generation Routing
VIDEO_PROVIDER=dashscope
VIDEO_TIMEOUT_MS=600000
VIDEO_POLL_INTERVAL_MS=15000

# Video Generation Provider (DashScope async task, legacy transition model)
VIDEO_API_KEY=
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
VIDEO_TASK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/tasks
VIDEO_MODEL=pixverse/pixverse-v6-kf2v
VIDEO_RESOLUTION=540P
VIDEO_DURATION_SECONDS=3

# Video Generation Provider (WanXiang 2.7 start/end frame model)
WANXIANG_VIDEO_API_KEY=
WANXIANG_VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
WANXIANG_VIDEO_TASK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/tasks
WANXIANG_VIDEO_MODEL=wan2.7-i2v-2026-04-25
WANXIANG_VIDEO_RESOLUTION=720P
WANXIANG_VIDEO_DURATION_SECONDS=5
WANXIANG_VIDEO_PROMPT_EXTEND=true
WANXIANG_VIDEO_WATERMARK=false

# Video Generation Provider (MiniMax start/end frame model)
MINIMAX_VIDEO_API_KEY=
MINIMAX_VIDEO_BASE_URL=https://api.minimaxi.com/v1/video_generation
MINIMAX_VIDEO_QUERY_URL=https://api.minimaxi.com/v1/query/video_generation
MINIMAX_VIDEO_FILE_BASE_URL=https://api.minimaxi.com/v1/files/retrieve
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
MINIMAX_VIDEO_RESOLUTION=768P
MINIMAX_VIDEO_DURATION_SECONDS=6
MINIMAX_VIDEO_PROMPT_OPTIMIZER=true
MINIMAX_VIDEO_WATERMARK=false
MINIMAX_VIDEO_CALLBACK_URL=

# Default Resolution
DEFAULT_WIDTH=1440
DEFAULT_HEIGHT=810
